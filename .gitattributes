# Attribute macros. These definitions are only honored when they live in the
# repository top-level .gitattributes; nested files may reference them.
[attr]lfs               filter=lfs diff=lfs merge=lfs -text

# Text normalization.
* text=auto eol=lf

# Windows command scripts require CRLF for reliable cmd.exe behavior.
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat generated or captured artifacts as binary.
*.bin binary
*.dll binary
*.exe binary
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.lib binary
*.pdb binary
*.png binary
*.zip binary

